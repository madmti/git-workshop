---
import Layout from '@/layouts/Layout.astro';
import EjercicioCard from '@/components/EjercicioCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('ejercicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<Layout>
	<main class="h-screen overflow-y-auto scroll-smooth px-12 py-10 max-sm:h-svh max-sm:px-6">
		<div class="mx-auto mb-8 flex max-w-6xl items-center justify-between">
			<a
				href={`${import.meta.env.BASE_URL}`}
				class="font-mono text-xs tracking-widest text-content/40 uppercase transition-colors hover:text-primary"
			>
				Volver
			</a>
			<div class="flex items-center gap-2 text-xs tracking-widest text-content/60 uppercase">
				<span class="text-content/50">Theme</span>
				<button
					data-theme="dark"
					type="button"
					class="theme-option cursor-pointer tracking-wide uppercase"
				>
					Dark
				</button>
				<span class="pointer-events-none text-content/50">|</span>
				<button
					data-theme="light"
					type="button"
					class="theme-option cursor-pointer tracking-wide uppercase"
				>
					Light
				</button>
			</div>
		</div>
		<header class="mx-auto mb-16 max-w-6xl">
			<p class="mb-4 font-mono text-xs tracking-widest text-content/40 uppercase">Ejercicios</p>
			<h1 class="mb-4 text-5xl font-bold text-primary">Ejercicios del Taller</h1>
			<p class="leading-7 text-content/60">
				Resumen de todos los ejercicios disponibles. Cada ejercicio pertenece a una clase del taller
				y puede ser un kahoot, un archivo descargable o un enlace externo.
			</p>
			<div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-content/60">
				<p>Revisa el codigo de los ejercicios en</p>
				<a
					href="https://github.com/madmti/git-workshop-labs"
					target="_blank"
					rel="noopener noreferrer"
					class="text-primary underline underline-offset-4 transition-colors hover:text-primary/80"
				>
					git-workshop-labs
				</a>
			</div>
		</header>

		<section class="mx-auto max-w-6xl">
			<h2 class="mb-8 font-mono text-xs tracking-widest text-content/40 uppercase">
				[ {entries.length} ejercicios ]
			</h2>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				{
					entries.map((entry) => (
						<EjercicioCard
							title={entry.data.title}
							description={entry.data.description}
							clase={entry.data.clase}
							badge={entry.data.badge}
							link={entry.data.link}
							label={entry.data.label}
							tipo={entry.data.tipo}
							draft={entry.data.draft}
						/>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	(() => {
		const body = document.body;
		const themeOptions = document.querySelectorAll('button.theme-option');

		if (!themeOptions.length) return;

		const setActiveOption = (buttons, value, attr) => {
			buttons.forEach((button) => {
				const isActive = button.getAttribute(attr) === value;
				button.classList.toggle('text-primary', isActive);
				button.classList.toggle('text-content/60', !isActive);
			});
		};

		const applyTheme = (theme) => {
			if (theme === 'light') {
				body.classList.add('light');
			} else {
				body.classList.remove('light');
			}
			setActiveOption(themeOptions, theme, 'data-theme');
		};

		const savedTheme = localStorage.getItem('theme') || 'light';
		applyTheme(savedTheme);

		themeOptions.forEach((button) => {
			button.addEventListener('click', () => {
				const nextTheme = button.getAttribute('data-theme') || 'light';
				applyTheme(nextTheme);
				localStorage.setItem('theme', nextTheme);
			});
		});
	})();
</script>
